{
  "name": "md-to-html",
  "private": true,
  "license": "MIT",
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run deploy:check && npm run blog:check && vite build && npm run prerender",
    "ext": "vite build --config vite.extension.config.ts",
    "ext:firefox": "vite build --config vite.extension.config.ts --mode firefox",
    "ext:art": "node scripts/store-art.mjs",
    "ext:zip": "npm run ext && node scripts/store-zip.mjs",
    "ext:zip:firefox": "npm run ext:firefox && node scripts/store-zip.mjs --firefox",
    "prerender": "vite build --ssr scripts/prerender.ts --outDir .prerender --emptyOutDir && node .prerender/prerender.js",
    "preview": "vite preview",
    "check-types": "tsc -b",
    "blog:check": "node scripts/check-blog.mjs",
    "og": "node scripts/og-images.mjs",
    "icons": "node scripts/icons.mjs",
    "db:init": "node scripts/init-db.mjs",
    "auth:origin": "node scripts/auth-origin.mjs",
    "env:setup": "node scripts/setup-env.mjs",
    "blob:migrate": "node scripts/sources-to-blob.mjs",
    "blob:reconcile": "node scripts/reconcile-blobs.mjs",
    "reports": "node scripts/reports.mjs",
    "docs:shots": "node scripts/screenshots.mjs",
    "mcp:check": "node scripts/check-mcp.mjs",
    "deploy:check": "node scripts/check-deploy.mjs",
    "store:check": "node scripts/check-store.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.67",
    "@hono/node-server": "^2.1.1",
    "@mozilla/readability": "^0.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@turbodocx/html-to-docx": "^1.23.0",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.97",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.2.7",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.7",
    "katex": "^0.18.7",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.2",
    "marked": "^15.0.12",
    "mermaid": "^12.0.0",
    "node-html-markdown": "^2.0.0",
    "node-html-parser": "^9.0.4",
    "pdfmake": "^0.3.11",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^4.10.0",
    "read-excel-file": "^9.3.10",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/diff": "^7.0.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "path-to-regexp": "^6.3.0",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^3.4.7",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-svgr": "^4.5.0"
  }
}
